<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = metaTitle or title %}<title>{% if "All Sewer" in pageTitle %}{{ pageTitle }}{% else %}{{ pageTitle }} | {{ site.shortName }}{% endif %}</title>
<meta name="description" content="{{ metaDescription or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ metaTitle or title }}">
<meta property="og:description" content="{{ metaDescription or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta name="robots" content="{% if noindex %}noindex,follow{% else %}index,follow,max-image-preview:large{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css">
<link rel="icon" href="/assets/img/favicon.png" type="image/png">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/img/logo.png' }}">
{% include "partials/schema.njk" %}
{% block head %}{% endblock %}
</head>
<body class="flex min-h-screen flex-col{% if site.callBar.enabled and callBar != false %} pb-20 lg:pb-0{% endif %}">
{% include "partials/header.njk" %}
<main id="main" class="flex-1">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{% include "partials/call-bar.njk" %}
{% include "partials/privacy-notice.njk" %}
{% if heroProof %}{% include "partials/video-modal.njk" %}{% endif %}
{% include "partials/analytics.njk" %}
<script>
function ytActivate(el) {
  if (el.dataset.loaded) return;
  el.dataset.loaded = "1";
  var f = document.createElement('iframe');
  f.className = 'yt-frame';
  f.src = 'https://www.youtube-nocookie.com/embed/' + el.dataset.yt + '?autoplay=1&rel=0';
  f.title = el.getAttribute('aria-label') || 'Video';
  f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
  f.allowFullscreen = true;
  el.appendChild(f);
}
var videoModal = document.getElementById('video-modal');
function videoOpen() {
  if (!videoModal) return;
  var box = videoModal.querySelector('[data-yt]');
  videoModal.classList.remove('hidden'); videoModal.classList.add('flex');
  document.body.style.overflow = 'hidden';
  ytActivate(box);
  var c = videoModal.querySelector('[data-video-close]'); if (c) c.focus();
  (window.dataLayer = window.dataLayer || []).push({ event: 'video_open', video_id: box.dataset.yt, page_path: location.pathname });
}
function videoClose() {
  if (!videoModal || videoModal.classList.contains('hidden')) return;
  var box = videoModal.querySelector('[data-yt]');
  box.innerHTML = ''; delete box.dataset.loaded;
  videoModal.classList.add('hidden'); videoModal.classList.remove('flex');
  document.body.style.overflow = '';
}
document.addEventListener('click', function (e) {
  if (e.target.closest('[data-video-open]')) { e.preventDefault(); videoOpen(); return; }
  if (e.target.closest('[data-video-close]') || e.target === videoModal) { videoClose(); return; }
  var rv = e.target.closest('[data-reviews-link]');
  if (rv) { (window.dataLayer = window.dataLayer || []).push({ event: 'reviews_click', page_path: location.pathname }); }
  var cb = e.target.closest('[data-callbar]');
  if (cb) { (window.dataLayer = window.dataLayer || []).push({ event: 'callbar_click', page_path: location.pathname }); }
  var yt = e.target.closest('[data-yt]');
  if (yt) { ytActivate(yt); return; }
  var t = e.target.closest('[data-toggle]');
  if (!t) return;
  var el = document.getElementById(t.getAttribute('data-toggle'));
  if (el) { el.hidden = !el.hidden; t.setAttribute('aria-expanded', el.hidden ? 'false' : 'true'); }
});
document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') { videoClose(); return; }
  if (e.key !== 'Enter' && e.key !== ' ') return;
  var yt = e.target.closest && e.target.closest('[data-yt]');
  if (yt) { e.preventDefault(); ytActivate(yt); }
});
</script>
</body>
</html>
