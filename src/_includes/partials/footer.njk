{% include "partials/quote.njk" %}
<footer class="bg-ink-950 text-white/75">
  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-3">
        <span class="grid h-11 w-11 place-items-center rounded-lg bg-brand-700 font-display text-lg font-bold text-white">ASP</span>
        <span class="font-display text-xl font-bold text-white">All Sewer &amp; Plumbing Services</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed">Repairing and replacing sewer lines without trenching Colorado yards since {{ site.since }}. Camera inspection, hydro jetting, CIPP lining and pipe bursting from our Westminster shop.</p>
      <p class="mt-4 text-sm"><span class="block text-white/50">{{ site.phoneCta }}</span><a class="font-display text-2xl font-bold text-accent-400" href="tel:+1{{ site.phone | phoneDigits }}">{{ site.phone }}</a></p>
      <p class="mt-3 text-xs text-white/45">{{ site.hq.street }}, {{ site.hq.city }}, {{ site.hq.region }} {{ site.hq.postalCode }}</p>
    </div>
    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wider text-white">Services</p>
      <ul class="mt-4 space-y-2 text-sm">
        {% for s in services %}<li><a class="hover:text-white" href="/{{ s.slug }}/">{{ s.title }}</a></li>{% endfor %}
      </ul>
    </div>
    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wider text-white">Areas Served</p>
      <ul class="mt-4 space-y-2 text-sm">
        {% for c in counties %}
        <li><a class="hover:text-white" href="/{{ c.slug }}/">{{ c.name }}</a></li>
        {% endfor %}
      </ul>
    </div>
    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wider text-white">Company</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="hover:text-white" href="/about/">About Us</a></li>
        <li><a class="hover:text-white" href="/our-process/">Our Process</a></li>
        <li><a class="hover:text-white" href="/blog/">Blog</a></li>
        <li><a class="hover:text-white" href="/faq/">Frequently Asked Questions</a></li>
        <li><a class="hover:text-white" href="/service-areas/">All Service Areas</a></li>
        <li><a class="hover:text-white" href="/contact/">Contact &amp; Free Estimate</a></li>
        <li><a class="hover:text-white" href="/privacy-policy/">Privacy Policy</a></li>
        <li><a class="hover:text-white" href="/terms-of-service/">Terms of Service</a></li>
        <li><a class="hover:text-white cursor-pointer" href="#" data-privacy-choices>Your Privacy Choices</a></li>
      </ul>
      <p class="mt-6 text-sm"><span class="block text-white/50">Hours</span>{{ site.hours }}</p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {% year %} {{ site.name }}. All rights reserved.</p>
      <p>Serving Denver, Adams, Jefferson, Arapahoe, Boulder, Douglas, Broomfield, Larimer &amp; Weld counties.</p>
    </div>
  </div>
</footer>
