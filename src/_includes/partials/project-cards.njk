{# Expects projectList. Each card links to the project write-up at /projects/<slug>/. #}
<div class="not-prose mt-6 grid gap-6 sm:grid-cols-2">
  {% for p in projectList %}
  <a class="group block overflow-hidden rounded-xl border border-ink-900/10 bg-white shadow-sm transition hover:border-brand-300 hover:shadow-md" href="{{ p.url }}">
    <img src="{{ p.image }}-600.webp" srcset="{{ p.image }}-600.webp 600w, {{ p.image }}-1200.webp 1200w" sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" alt="{{ p.imageAlt }}" width="1200" height="630" loading="lazy" decoding="async" class="block aspect-[40/21] w-full object-cover">
    <div class="p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-brand-700">{{ p.place }}, CO &middot; {{ p.method }}</p>
      <h3 class="mt-2 text-lg leading-snug text-ink-950 group-hover:text-brand-800">{{ p.cardTitle }}</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-700">{{ p.summary }}</p>
      <p class="mt-3 text-sm font-semibold text-brand-700">Read the project story &rarr;</p>
    </div>
  </a>
  {% endfor %}
</div>
