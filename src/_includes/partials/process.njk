<section class="bg-ink-950 text-white/75">
  <div class="container-x py-16">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-400">How a job runs</p>
    <h2 class="mt-2 text-3xl text-white sm:text-4xl">Camera first. Always.</h2>
    <p class="mt-4 max-w-3xl text-white/75">A sewer quote given without video is a guess, and guesses are how homeowners end up paying for a liner that was never going to fix the problem. Here's the sequence we follow on every job.</p>
    <ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {% for p in process %}
      <li class="rounded-xl border border-white/10 bg-white/5 p-6">
        <span class="font-display text-sm font-bold text-accent-400">Step {{ loop.index }}</span>
        <h3 class="mt-1 text-lg text-white">{{ p.step }}</h3>
        <p class="mt-2 text-sm leading-relaxed text-white/70">{{ p.detail }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
