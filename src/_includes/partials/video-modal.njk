{#
  Process-video modal. Opened by any [data-video-open] (see partials/hero-proof.njk).
  The YouTube iframe is injected only when opened (ytActivate in base.njk) and torn
  down on close so playback stops. Closes on the X, the backdrop, or Escape.
#}
<div id="video-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-ink-950/90 p-4 backdrop-blur-sm sm:p-8"
     role="dialog" aria-modal="true" aria-label="{{ site.video.title }}">
  <div class="relative w-full max-w-4xl">
    <button type="button" data-video-close
      class="absolute -top-11 right-0 inline-flex items-center gap-2 rounded-full border border-white/25 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
      aria-label="Close video">
      Close
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="relative aspect-video w-full overflow-hidden rounded-2xl bg-black shadow-2xl"
         data-yt="{{ site.video.id }}" data-yt-modal aria-label="{{ site.video.title }}"></div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-white/75">{{ site.video.title }}</p>
      <a class="btn-primary text-sm" href="tel:+1{{ site.phone | phoneDigits }}">{{ site.phoneCta }} {{ site.phone }}</a>
    </div>
  </div>
</div>
