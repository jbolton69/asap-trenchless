{% set activePhone = site.phone %}
<section id="quote" class="bg-brand-800 text-white">
  <div class="container-x grid gap-10 py-16 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-400">Free Estimates</p>
      <h2 class="mt-3 text-3xl text-white sm:text-4xl">Find out what's actually wrong with your sewer line{% if cityName %} in {{ cityName }}{% endif %}.</h2>
      <p class="mt-4 max-w-xl text-white/80">Tell us what's happening and we'll get a camera on the line. You'll get the footage, a written finding, and a straight recommendation — including when trenchless is <em>not</em> the right answer.</p>
      <div class="mt-8 space-y-4">
        <a class="flex items-center gap-4 rounded-xl bg-white/10 p-4 transition hover:bg-white/15" href="tel:+1{{ activePhone | phoneDigits }}">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-accent-500 text-ink-950">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l2 5-2.5 1.5a12 12 0 006 6L15 14l5 2v3a2 2 0 01-2 2A15 15 0 013 6a2 2 0 012-2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </span>
          <span>
            <span class="block text-xs font-semibold uppercase tracking-wider text-white/60">{{ site.phoneCta }}</span>
            <span class="block font-display text-2xl font-bold text-white">{{ activePhone }}</span>
          </span>
        </a>
        <ul class="grid gap-2 text-sm text-white/80">
          <li class="flex gap-2"><span class="text-accent-400">&#10003;</span> Camera inspection before any quote — no guessing</li>
          <li class="flex gap-2"><span class="text-accent-400">&#10003;</span> Most residential lining jobs finished in one day</li>
          <li class="flex gap-2"><span class="text-accent-400">&#10003;</span> City and sanitation district permits handled for you</li>
          <li class="flex gap-2"><span class="text-accent-400">&#10003;</span> Trenchless sewer work in Colorado since {{ site.since }}</li>
        </ul>
      </div>
    </div>
    <div class="rounded-2xl bg-white p-6 text-ink-800 shadow-2xl sm:p-8">
      <h3 class="text-2xl">Request a free estimate</h3>
      <p class="mt-1 text-sm text-ink-700">We will contact you within 24 hours. In a hurry? Call now.</p>
      {% if site.form.accessKey and "REPLACE" not in site.form.accessKey %}
      <form class="mt-6 grid gap-4" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="{{ site.form.accessKey }}">
        <input type="hidden" name="subject" value="New estimate request — {{ site.shortName }} website">
        <input type="hidden" name="from_name" value="{{ site.shortName }} website">
        <input type="hidden" name="redirect" value="{{ site.url }}/thank-you/">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-semibold">Name
            <input required name="name" type="text" autocomplete="name" class="mt-1 w-full rounded-lg border border-ink-900/20 px-3 py-2.5 font-normal focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200">
          </label>
          <label class="block text-sm font-semibold">Phone
            <input required name="phone" type="tel" autocomplete="tel" class="mt-1 w-full rounded-lg border border-ink-900/20 px-3 py-2.5 font-normal focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200">
          </label>
        </div>
        <label class="block text-sm font-semibold">Email
          <input required name="email" type="email" autocomplete="email" class="mt-1 w-full rounded-lg border border-ink-900/20 px-3 py-2.5 font-normal focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200">
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-semibold">City
            <input name="city" type="text" autocomplete="address-level2" class="mt-1 w-full rounded-lg border border-ink-900/20 px-3 py-2.5 font-normal focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200">
          </label>
          <label class="block text-sm font-semibold">Property type
            <select name="property_type" class="mt-1 w-full rounded-lg border border-ink-900/20 px-3 py-2.5 font-normal focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200">
              <option>Single-family home</option>
              <option>Condo or townhome</option>
              <option>Apartment / multifamily</option>
              <option>Commercial</option>
              <option>HOA / property management</option>
            </select>
          </label>
        </div>
        <label class="block text-sm font-semibold">What's happening?
          <textarea name="message" rows="4" placeholder="Recurring backups, a camera report from another company, a real estate inspection finding..." class="mt-1 w-full rounded-lg border border-ink-900/20 px-3 py-2.5 font-normal focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200"></textarea>
        </label>
        <input type="hidden" name="page_url" value="{{ site.url }}{{ page.url }}">
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off">
        <button class="btn-primary w-full" type="submit">Send request</button>
        <p class="text-xs text-ink-700">Estimates are free. Call now: <a class="font-semibold text-brand-700 underline" href="tel:+1{{ activePhone | phoneDigits }}">{{ activePhone }}</a>.</p>
      </form>
      {% else %}
      <div class="mt-6 rounded-xl border border-accent-500/40 bg-accent-500/10 p-5 text-sm leading-relaxed text-ink-800">
        <strong>Form not connected yet.</strong> Add the Web3Forms access key to
        <code>src/_data/site.json</code> under <code>form.accessKey</code> and rebuild.
        Until then the form is hidden rather than shown broken, so no enquiry is silently lost.
        <p class="mt-3">Call <a class="font-semibold text-brand-700 underline" href="tel:+1{{ activePhone | phoneDigits }}">{{ activePhone }}</a> in the meantime.</p>
      </div>
      {% endif %}
    </div>
  </div>
</section>
