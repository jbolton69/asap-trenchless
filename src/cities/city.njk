---
pagination:
  data: cities
  size: 1
  alias: city
  addAllPagesToCollections: true
permalink: "/{{ city.county }}/{{ city.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "Trenchless Sewer Repair in {{ city.fullName }}"
  metaTitle: "Trenchless Sewer Repair in {{ city.fullName }} | Sewer Line Lining & Bursting"
  metaDescription: "No-dig sewer line repair in {{ city.fullName }}. Camera inspection, CIPP lining and pipe bursting, with a straight answer when trenchless isn't right. Estimates are free."
  cityName: "{{ city.name }}"
  citySlug: "{{ city.slug }}"
---
{% set countyObj = (counties | where("slug", city.county))[0] %}
{% set siblings = cities | where("county", city.county) %}
{% set cityProjects = projects | where("city", city.slug) %}

<section class="bg-gradient-to-b from-brand-950 to-brand-800 text-white">
  <div class="container-x py-14 sm:py-20">
    <nav aria-label="Breadcrumb" class="mb-5 text-xs text-white/60">
      <a class="hover:text-white" href="/">Home</a> <span class="px-1">/</span>
      <a class="hover:text-white" href="/{{ countyObj.slug }}/">{{ countyObj.name }}</a> <span class="px-1">/</span>
      <span class="text-white/80">{{ city.name }}</span>
    </nav>
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-400">{{ city.fullName | replace(", CO", ", Colorado") }}</p>
    <h1 class="mt-3 max-w-4xl text-4xl text-white sm:text-5xl">Trenchless Sewer Repair in {{ city.name }}</h1>
    <p class="mt-5 max-w-2xl text-lg text-white/80">Sewer line repair and replacement in {{ city.name }} without trenching your yard, driveway or slab &mdash; and an honest answer when trenchless isn't the right call.</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a class="btn-primary" href="tel:+1{{ site.phone | phoneDigits }}">Call {{ site.phone }}</a>
      <a class="btn-ghost" href="#quote">Free estimate</a>
    </div>
    <p class="mt-4 text-sm text-white/60">{{ site.phoneCta }} &middot; {{ site.hours }}</p>
  </div>
</section>

<div class="container-x grid gap-12 py-14 lg:grid-cols-[minmax(0,1fr)_320px]">
  <div class="prose-site max-w-none">
    <h2>What we find under {{ city.name }} homes</h2>
    <p>{{ city.local }}</p>

    <div class="not-prose my-8 grid gap-4 rounded-2xl border border-ink-900/10 bg-ink-950/[0.02] p-6 sm:grid-cols-2">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-brand-700">When {{ city.name }} was built</p>
        <p class="mt-1 text-sm leading-relaxed text-ink-700">{{ city.builtEra }}</p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-brand-700">Pipe we typically find</p>
        <p class="mt-1 text-sm leading-relaxed text-ink-700">{{ city.commonPipe }}</p>
      </div>
      <div class="sm:col-span-2">
        <p class="text-xs font-bold uppercase tracking-wider text-brand-700">Sewer service</p>
        <p class="mt-1 text-sm leading-relaxed text-ink-700">{{ city.sewerAuthority }}</p>
      </div>
      <div class="sm:col-span-2">
        <p class="text-xs font-bold uppercase tracking-wider text-brand-700">Neighborhoods we work in</p>
        <p class="mt-1 text-sm leading-relaxed text-ink-700">{{ city.neighborhoods | join(" &middot; ") | safe }}</p>
      </div>
      {% if city.zips %}
      <div class="sm:col-span-2">
        <p class="text-xs font-bold uppercase tracking-wider text-brand-700">ZIP codes served</p>
        <p class="mt-1 text-sm leading-relaxed text-ink-700">{{ city.zips | join(", ") }}</p>
      </div>
      {% endif %}
    </div>

    <p>{{ city.local2 }}</p>

    <h3>What our camera work in {{ city.name }} usually turns up</h3>
    <ul>
      {% for s in city.signals %}<li>{{ s }}</li>{% endfor %}
    </ul>

    <h2>Choosing a method for a {{ city.name }} sewer line</h2>
    <p>No method is the default. Cracks, roots and leaking joints in a pipe that still slopes toward the main can usually be lined. A line that has collapsed, flattened or sagged into a belly needs to be burst or dug and replaced, because a liner cures to whatever shape the old pipe has. One bad spot in an otherwise sound line may only need a small spot repair. The camera shows which of those you have, and you see the same footage we do.</p>

    <div class="not-prose my-8 grid gap-4 sm:grid-cols-3">
      {% for s in services %}{% if s.slug in ["cipp-pipe-lining","pipe-bursting","sewer-line-replacement"] %}
      <a class="card block transition hover:border-brand-300 hover:shadow-md" href="/{{ s.slug }}/">
        <h3 class="text-lg text-ink-950">{{ s.title }}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-700">{{ s.short }}</p>
        <p class="mt-3 text-sm font-semibold text-brand-700">How it works &rarr;</p>
      </a>
      {% endif %}{% endfor %}
    </div>

    <h2>Permits and ownership in {{ city.name }}</h2>
    <p>{{ city.permitNote }}</p>

{% if cityProjects | length %}
    <h2>Recent work in {{ city.name }}</h2>
    {% set projectList = cityProjects %}
    {% include "partials/project-cards.njk" %}
{% endif %}

    <h2>{{ city.name }} sewer questions</h2>
    <div class="not-prose mt-4 divide-y divide-ink-900/10 border-y border-ink-900/10">
      {% for f in city.faqs %}
      <details class="group py-4"{% if loop.first %} open{% endif %}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-950">
          {{ f.q }}
          <span class="shrink-0 text-brand-700 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-[15px] leading-relaxed text-ink-700">{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
    <p class="mt-6"><strong>{{ site.phoneCta }}</strong> <a href="tel:+1{{ site.phone | phoneDigits }}">{{ site.phone }}</a></p>

{% if siblings | length > 1 %}
    <h2>Also serving nearby</h2>
    <div class="not-prose mt-4 flex flex-wrap gap-2">
      {% for n in siblings %}{% if n.slug != city.slug %}
      <a class="rounded-full border border-ink-900/10 px-3 py-1.5 text-sm font-medium text-ink-700 transition hover:border-brand-300 hover:bg-brand-50 hover:text-brand-800" href="/{{ n.county }}/{{ n.slug }}/">{{ n.name }}</a>
      {% endif %}{% endfor %}
    </div>
{% endif %}
    <p class="mt-6"><a href="/{{ countyObj.slug }}/">See our full {{ countyObj.name }} service area &rarr;</a></p>
  </div>
  <aside class="lg:sticky lg:top-28 lg:self-start">
    {% include "partials/sidebar.njk" %}
  </aside>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for f in city.faqs %}{"@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": {"@type": "Answer", "text": {{ f.a | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
</script>

{% include "partials/reviews.njk" %}
