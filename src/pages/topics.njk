---
pagination:
  data: collections.topicList
  size: 1
  alias: topic
  addAllPagesToCollections: true
permalink: "/blog/topic/{{ topic | slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ topic }}"
  metaTitle: "{{ topic }} | All Sewer & Plumbing Blog"
  metaDescription: "Articles about {{ topic }} from All Sewer and Plumbing Services."
---
<section class="bg-gradient-to-b from-brand-950 to-brand-800 text-white">
  <div class="container-x py-12 sm:py-16">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-white/60">
      <a class="hover:text-white" href="/">Home</a> <span class="px-1">/</span>
      <a class="hover:text-white" href="/blog/">Blog</a> <span class="px-1">/</span>
      <span class="text-white/80">{{ topic }}</span>
    </nav>
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-400">Topic</p>
    <h1 class="mt-3 text-4xl text-white sm:text-5xl">{{ topic }}</h1>
  </div>
</section>
<div class="container-x py-14">
  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
    {% for p in collections.posts %}{% if topic in (p.data.topics or []) %}
    <article class="card flex flex-col">
      <h2 class="text-xl"><a class="hover:text-brand-700" href="{{ p.url }}">{{ p.data.title }}</a></h2>
      <p class="mt-3 flex-1 text-[15px] leading-relaxed text-ink-700">{{ p.data.description | excerpt(150) }}</p>
      <p class="mt-4 border-t border-ink-900/10 pt-3 text-xs text-ink-700"><time datetime="{{ p.date | isoDate }}">{{ p.date | readableDate }}</time></p>
    </article>
    {% endif %}{% endfor %}
  </div>
  <p class="mt-10"><a class="font-semibold text-brand-700 hover:text-brand-800" href="/blog/">&larr; All articles</a></p>
</div>
