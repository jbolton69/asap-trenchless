---
pagination:
  data: collections.posts
  size: 9
  alias: posts
  addAllPagesToCollections: true
permalink: "{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
layout: layouts/base.njk
eleventyComputed:
  title: "Trenchless Sewer Blog{% if pagination.pageNumber > 0 %} — Page {{ pagination.pageNumber + 1 }}{% endif %}"
  metaTitle: "Trenchless Sewer Repair Blog | All Sewer & Plumbing{% if pagination.pageNumber > 0 %} — Page {{ pagination.pageNumber + 1 }}{% endif %}"
  metaDescription: "Straight explanations of trenchless sewer work — what fails, which method fixes it, and when trenchless is the wrong answer."
---
<section class="bg-gradient-to-b from-brand-950 to-brand-800 text-white">
  <div class="container-x py-14 sm:py-20">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-400">Blog</p>
    <h1 class="mt-3 max-w-3xl text-4xl text-white sm:text-5xl">Trenchless sewer repair, explained plainly</h1>
    <p class="mt-5 max-w-2xl text-lg text-white/80">What goes wrong with sewer lines along the Colorado Front Range, which repair fits, and when digging is still the right call.</p>
  </div>
</section>

<div class="container-x py-14">
  {% if posts | length %}
  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
    {% for p in posts %}
    <article class="card flex flex-col">
      {% if p.data.image %}
      <a class="mb-4 block overflow-hidden rounded-lg" href="{{ p.url }}">
        <img
          class="aspect-[16/9] w-full object-cover transition duration-300 hover:scale-[1.03]"
          {# assets follow name-WIDTH.webp, so a card can take the lighter variant #}
          src="/assets/img/{{ p.data.image | replace('-2000.', '-800.') | replace('-1600.', '-800.') | replace('-1200.', '-800.') }}"
          alt="{{ p.data.imageAlt or '' }}"
          width="800" height="450"
          loading="lazy" decoding="async">
      </a>
      {% endif %}
      {% if p.data.topics %}
      <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{{ p.data.topics[0] }}</p>
      {% endif %}
      <h2 class="mt-2 text-xl"><a class="hover:text-brand-700" href="{{ p.url }}">{{ p.data.title }}</a></h2>
      <p class="mt-3 flex-1 text-[15px] leading-relaxed text-ink-700">{{ p.data.description | excerpt(150) }}</p>
      <p class="mt-4 border-t border-ink-900/10 pt-3 text-xs text-ink-700">
        <time datetime="{{ p.date | isoDate }}">{{ p.date | readableDate }}</time>
        <span class="px-1.5">&middot;</span>{{ p.templateContent | readingTime }} min read
      </p>
    </article>
    {% endfor %}
  </div>

  {% if pagination.pages | length > 1 %}
  <nav class="mt-12 flex items-center justify-between border-t border-ink-900/10 pt-6" aria-label="Pagination">
    <div>{% if pagination.href.previous %}<a class="btn-secondary text-sm" href="{{ pagination.href.previous }}">&larr; Newer</a>{% endif %}</div>
    <p class="text-sm text-ink-700">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}</p>
    <div>{% if pagination.href.next %}<a class="btn-secondary text-sm" href="{{ pagination.href.next }}">Older &rarr;</a>{% endif %}</div>
  </nav>
  {% endif %}
  {% else %}
  <p class="prose-site">No posts yet.</p>
  {% endif %}
</div>
